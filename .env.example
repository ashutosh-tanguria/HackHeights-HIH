# Create .env with:  pnpm setup   (generates random secrets; never commit .env)

# --- target model ---
# ollama = real model through the gateway (MEASURED claims allowed)
# mock   = offline stub; every result is labelled MOCK and cannot be used as a measurement
TARGET_LLM_PROVIDER=ollama
TARGET_LLM_ENDPOINT=http://localhost:11434
TARGET_LLM_MODEL=qwen2.5:0.5b
TARGET_LLM_API_KEY=

# --- secrets (pnpm setup fills these; at least 16 characters) ---
BAYORA_TOKEN_SECRET=
BAYORA_ADMIN_KEY=
BAYORA_RED_ENROLL_SECRET=
BAYORA_BLUE_ENROLL_SECRET=

# --- gateway limits ---
GATEWAY_RATE_LIMIT_MAX=300
GATEWAY_RATE_LIMIT_WINDOW_MS=60000
GATEWAY_CONCURRENCY_CAP=4
BAYORA_TOKEN_TTL_SECONDS=900

# --- Blue defence: remote (inside the Blue container, used by docker compose) | local (in-process, dev only) ---
BLUE_FILTER_MODE=local
BLUE_DEFENSE_DEFAULT=on

# --- console (apps/web) and demo script ---
BAYORA_API_URL=http://localhost:4000

# --- docker compose only: group id of /var/run/docker.sock on Linux (Docker Desktop: leave 0) ---
DOCKER_GID=0
