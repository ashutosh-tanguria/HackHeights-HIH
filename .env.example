# ==============================================================
# BAYORA Environment Configuration (Hack in Hills - PS-04)
# ==============================================================

# Server Network Configuration
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Service Role (gateway, api, or unified)
SERVICE_ROLE=unified
GATEWAY_URL=http://gateway:4000

# Target Model Provider: "ollama" (preferred CPU-friendly), "openai" (hosted fallback), or "mock" (offline test)
TARGET_LLM_PROVIDER=mock
TARGET_LLM_ENDPOINT=http://target:11434
TARGET_LLM_MODEL=qwen2.5:0.5b
TARGET_LLM_API_KEY=

# Optional OpenAI Evaluation Judge Key
OPENAI_API_KEY=
OPENAI_EVALUATION_MODEL=gpt-4o-mini

# Cryptographic Token Secret & HMAC Salt Key
# (Leave empty to auto-generate a secure random secret on startup)
BAYORA_TOKEN_SECRET=
BAYORA_ADMIN_KEY=

# Gateway Rate Limiting & Quotas
GATEWAY_RATE_LIMIT_MAX=10
GATEWAY_RATE_LIMIT_WINDOW_MS=60000
