{
  "name": "bayora",
  "version": "1.0.0",
  "description": "Bayora: isolated infrastructure for adversarial AI safety testing (Hack in Hills, PS-04)",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "pnpm --filter @oosc/api test",
    "verify": "pnpm install && pnpm typecheck && pnpm test && pnpm build",
    "demo": "tsx scripts/demo.ts",
    "fetch:datasets": "node scripts/fetch-datasets.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "tsx": "^4.19.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
