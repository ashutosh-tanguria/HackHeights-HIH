{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "typeRoots": ["../apps/api/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["./**/*.ts", "../apps/api/src/**/*.ts"]
}
